{
  "id": "study.pomodoro",
  "icon": "icon.svg",
  "version": "1.0.0",
  "api": {"host": ">=1.0 <2.0"},
  "activation": ["onStartupFinished"],
  "contributes": {
    "unitTypes": [{"id":"timer-default","label":"番茄钟计时器","dataInputs":[{"id":"timer-storage","contract":"study.pomodoro/v1","access":"write"}]}],
    "presentations": [
      {"id": "micro", "label": "番茄钟", "renderer": "timer", "mode": "micro", "when": {"maxCols": 5, "maxRows": 4}, "priority": 40},
      {"id": "strip", "label": "番茄钟", "renderer": "timer", "mode": "compact", "when": {"minCols": 6, "maxRows": 8}, "priority": 30},
      {"id": "phone", "label": "番茄钟", "renderer": "timer", "mode": "phone", "when": {"maxCols": 7, "minRows": 5}, "priority": 20},
      {"id": "full", "label": "番茄钟", "renderer": "timer", "mode": "full", "when": {"minCols": 8, "minRows": 5}, "priority": 10},
      {"id": "default", "label": "番茄钟", "renderer": "timer", "mode": "compact", "default": true}
    ]
  },
  "permissions": ["data.read:installation-owned", "data.write:installation-owned", "data.provision:installation-owned"]
}
