{
  "id": "study.table-grid",
  "icon": "icon.svg",
  "iconPresentation": {"mode":"template"},
  "version": "1.0.0",
  "api": {
    "host": ">=1.0 <2.0"
  },
  "activation": [
    "onStartupFinished"
  ],
  "contributes": {
    "unitTypes": [{"id":"table-view","label":"表格视图","dataInputs":[{"id":"source","contract":"workbench.table/ref","access":"read"}]}],
    "transfers": {
      "accepts": [
        {
          "type": "workbench.table/ref",
          "label": "Table reference"
        }
      ],
      "offers": [
        {
          "type": "workbench.row/ref",
          "label": "Selected row"
        }
      ]
    },
    "presentations": [
      {
        "id": "compact",
        "label": "表格",
        "renderer": "table-grid",
        "mode": "compact",
        "when": {
          "maxCols": 5
        },
        "priority": 20
      },
      {
        "id": "short",
        "label": "表格",
        "renderer": "table-grid",
        "mode": "compact",
        "when": {
          "maxRows": 12
        },
        "priority": 10
      },
      {
        "id": "default",
        "label": "表格",
        "renderer": "table-grid",
        "default": true
      }
    ]
  },
  "permissions": [
    "data.read:table",
    "data.write:table"
  ]
}
