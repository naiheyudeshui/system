{
  "id": "study.table-catalog",
  "icon": "icon.svg",
  "iconPresentation": {"mode":"template"},
  "version": "1.0.0",
  "api": {
    "host": ">=1.0 <2.0"
  },
  "activation": [
    "onStartupFinished"
  ],
  "contributes": {
    "transfers": {
      "offers": [
        {
          "type": "workbench.table/ref",
          "label": "Table reference"
        }
      ]
    },
    "presentations": [
      {
        "id": "compact",
        "label": "表格目录",
        "renderer": "table-catalog",
        "mode": "compact",
        "when": {
          "maxCols": 5
        },
        "priority": 10
      },
      {
        "id": "default",
        "label": "表格目录",
        "renderer": "table-catalog",
        "default": true
      }
    ]
  },
  "permissions": [
    "data.read:schema"
  ]
}
