{
  "id": "study.metrics",
  "icon": "icon.svg",
  "version": "1.0.0",
  "api": {
    "host": ">=1.0 <2.0"
  },
  "activation": [
    "onStartupFinished"
  ],
  "contributes": {
    "presentations": [
      {
        "id": "strip",
        "label": "指标栏",
        "renderer": "metrics",
        "mode": "strip",
        "when": {
          "maxRows": 4
        },
        "priority": 10
      },
      {
        "id": "default",
        "label": "指标栏",
        "renderer": "metrics",
        "mode": "grid",
        "default": true
      }
    ]
  },
  "permissions": [
    "data.read:metrics"
  ]
}
